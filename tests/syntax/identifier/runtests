#!/bin/bash

# Test that the names our lexer turns into tokens, although IEC 61131-3 does not
# reserve them (IL operators, SFC action qualifiers, task initialisers), may still
# be used as identifiers.
#
#   *.test          --> a template, in which XXXX stands for the identifier under test.
#                       Its lines starting with '#' list the identifiers to try; words
#                       starting with '#' are ignored (group names, and identifiers that
#                       cannot be used there). Each identifier gives an instance of the
#                       template, which iec2iec must accept.
#   basic_code.test --> ordinary IL, ST and SFC code, included by every template to check
#                       that the declarations under test do not break it.

# IEC2IEC may name the compiler under test ('make check' does), the default
# being the one of an in-tree build.
IEC2IEC=${IEC2IEC:-../../../iec2iec}
IEC2IEC_FLAGS="-f -I ../../../lib"
OUTDIR="./output"

# assume no error to start with...
error=0

rm -rf $OUTDIR
mkdir -p $OUTDIR

for ff in `ls *.test`
do
  for id in `grep "^#" $ff | sed "s/#[^ ]*//g"`
  do
    instance=$OUTDIR/`basename $ff .test`_$id
    sed s/XXXX/$id/g $ff > $instance.iec
    if "$IEC2IEC" $IEC2IEC_FLAGS $instance.iec > $instance.out 2> $instance.err
      then echo "[ O K ]   " $ff "->" $id
      else echo "[ERROR]   " $ff "->" $id; sed "s/^/             /" $instance.err; error=1
    fi
  done
done

echo
if `test $error = 1`
  then echo "FAILURE -> At least one of the tests failed!"
  else echo "SUCCESS -> All tests passed!"
fi

exit $error
